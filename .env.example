# ========================================================
# CRAG Knowledge Searching Configuration
# ========================================================

# 1. Tavily Search API Key (Required for general web fact-checking)
# Obtain from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 2. NCBI PubMed E-utilities Configuration (Peer-reviewed literature)
# NCBI requests contact info to prevent automated rate-limiting
NCBI_EMAIL=your_email@domain.com

# (Optional) NCBI API Key: increases rate limits from 3 req/s to 10 req/s
# NCBI_API_KEY=your_ncbi_api_key_here

